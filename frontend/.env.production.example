# ==============================================================================
# Variables de Entorno de Producción - Frontend (Vercel)
# Natbell E-commerce (Los Arrayanes)
# ==============================================================================

# URL pública de la API de Backend en Render (SIN barra diagonal final)
# Esta variable es consumida por el cliente y las rutas del App Router
NEXT_PUBLIC_API_URL="https://natbell-api.onrender.com"

# Clave pública de MercadoPago para producción (Inicia con APP_USR-...)
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-00000000-0000-0000-0000-000000000000"

# Instrucciones para Vercel:
# 1. Al importar el proyecto en Vercel, configurar Root Directory en 'frontend'.
# 2. En Settings -> Environment Variables, agregar NEXT_PUBLIC_API_URL con el valor
#    de tu servicio de Render (ej: https://natbell-api.onrender.com).
# 3. Guardar y desplegar.
