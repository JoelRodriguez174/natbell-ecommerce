# ==============================================================================
# Variables de Entorno de Producción - Backend (Render)
# Natbell E-commerce (Los Arrayanes)
# ==============================================================================

# Nombre de la aplicación y fase activa
APP_NAME="Natbell API"
PHASE=8

# Entorno de red y URLs públicas
# FRONTEND_URL: Dominio oficial de Vercel asignado a la tienda
FRONTEND_URL="https://natbell.vercel.app"
# BACKEND_URL: Dominio público de Render asignado a la API
BACKEND_URL="https://natbell-api.onrender.com"

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS="https://natbell.vercel.app,https://www.natbell.com.ar"

# ------------------------------------------------------------------------------
# Supabase Cloud (Base de Datos PostgreSQL y Storage)
# ------------------------------------------------------------------------------
# SUPABASE_URL: URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_KEY: Service Role Key (privada, bypass RLS para backend seguro)
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_ANON_KEY: Clave anónima pública del proyecto
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# MercadoPago Checkout Pro (Credenciales de Producción)
# ------------------------------------------------------------------------------
# MERCADOPAGO_ACCESS_TOKEN: Access Token de Producción (Inicia con APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000"

# MERCADOPAGO_PUBLIC_KEY: Public Key de Producción (Inicia con APP_USR-...)
MERCADOPAGO_PUBLIC_KEY="APP_USR-00000000-0000-0000-0000-000000000000"

# MERCADOPAGO_WEBHOOK_SECRET: Clave secreta para validación de firma HMAC de webhooks
MERCADOPAGO_WEBHOOK_SECRET="your_webhook_secret_signature"

# Flag para desactivar modo pruebas/sandbox y procesar transacciones reales
MERCADOPAGO_SANDBOX=false
MERCADOPAGO_MODE="real"

# ------------------------------------------------------------------------------
# Seguridad Administrativa & Autenticación JWT
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: Clave criptográfica aleatoria de al menos 64 caracteres
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY="generate-a-strong-random-secret-key-for-production-use-min-64-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=480

# ADMIN_INVITE_CODE: Clave maestra secreta que la empresa comparte únicamente con personal autorizado
# para habilitar el registro de nuevas cuentas de administración en /admin/registro
ADMIN_INVITE_CODE="generate-a-secure-random-master-invite-code"

# ------------------------------------------------------------------------------
# Envío de Emails Transaccionales (Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: Clave de API de Resend (inicia con re_...) obtenida en https://resend.com
RESEND_API_KEY="re_000000000000000000000000"
# EMAIL_FROM: Remitente verificado (ej: "Natbell <no-reply@tudominio.com>" o "onboarding@resend.dev")
EMAIL_FROM="Natbell <onboarding@resend.dev>"

