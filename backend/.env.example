# Backend Configuration
APP_NAME="Natbell API"
PHASE=6
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# Supabase Configuration
# Obtener de: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-public-key"

# MercadoPago Configuration
# Obtener de: Mercado Pago Developers -> Tus integraciones -> Credenciales de prueba
MERCADOPAGO_ACCESS_TOKEN="TEST-your-access-token"
MERCADOPAGO_PUBLIC_KEY="TEST-your-public-key"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"
MERCADOPAGO_MODE="auto" # auto, mock, o real

# Seguridad Administrativa (Fase 7 & Registro Seguro)
JWT_SECRET_KEY="test-secret-key-for-local-development"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=480
ADMIN_INVITE_CODE="NatbellAdmin2026!"

# Servicio de Emails Transaccionales (Resend)
# Si se deja vacío, el backend simula el envío e imprime el OTP en consola
RESEND_API_KEY=""
EMAIL_FROM="Natbell <onboarding@resend.dev>"
