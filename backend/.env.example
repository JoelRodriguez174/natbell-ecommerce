# Backend Configuration
APP_NAME="Natbell API"
PHASE=6
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# Supabase Configuration
# Obtener de: Supabase Dashboard -> Project Settings -> API
